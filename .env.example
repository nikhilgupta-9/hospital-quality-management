#--------------------------------------------------------------------
# HOSPITAL QUALITY MANAGEMENT — NABH COMPLIANCE PORTAL
# Copy this file to .env and adjust for your machine. .env itself is
# git-ignored — every environment (your XAMPP, a teammate's, staging)
# keeps its own copy.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/hospital-quality/public/'

database.default.hostname = localhost
database.default.database = hospital_quality
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Generate your own with: php spark key:generate
encryption.key =

# Used only by app/Database/Seeds/SuperAdminSeeder.php on first seed.
# Optional — falls back to superadmin@example.com / ChangeMe!123 if unset.
# SUPERADMIN_EMAIL =
# SUPERADMIN_PASSWORD =
